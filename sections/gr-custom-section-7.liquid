<section id="{{ section.settings.section_anchor | default: 'shop-options' }}" class="custom-mf-products section-{{ section.id }}">
  <div class="custom-mf-products__inner">
    {% if section.settings.heading != blank %}
      <h2 class="custom-mf-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="custom-mf-products__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    <div class="custom-mf-products__grid">
      {% for block in section.blocks %}
        <div class="custom-mf-products__card {% if block.settings.featured %}is-featured{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}
            <div class="custom-mf-products__badge">{{ block.settings.badge }}</div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="custom-mf-products__title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.subtitle != blank %}
            <div class="custom-mf-products__subtitle">{{ block.settings.subtitle }}</div>
          {% endif %}

          {% if block.settings.image != blank %}
            {{ block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                class: 'custom-mf-products__image',
                alt: block.settings.image_alt
            }}
          {% endif %}

          <div class="custom-mf-products__price-row">
            {% if block.settings.price != blank %}
              <div class="custom-mf-products__price">{{ block.settings.price }}</div>
            {% endif %}

            {% if block.settings.compare_price != blank %}
              <div class="custom-mf-products__compare"><s>{{ block.settings.compare_price }}</s></div>
            {% endif %}
          </div>

          {% if block.settings.savings != blank %}
            <div class="custom-mf-products__savings">{{ block.settings.savings }}</div>
          {% endif %}

          <ul class="custom-mf-products__features">
            {% if block.settings.feature_1 != blank %}
              <li>{{ block.settings.feature_1 }}</li>
            {% endif %}
            {% if block.settings.feature_2 != blank %}
              <li>{{ block.settings.feature_2 }}</li>
            {% endif %}
            {% if block.settings.feature_3 != blank %}
              <li>{{ block.settings.feature_3 }}</li>
            {% endif %}
            {% if block.settings.feature_4 != blank %}
              <li>{{ block.settings.feature_4 }}</li>
            {% endif %}
          </ul>

          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a class="custom-mf-products__button {% if block.settings.featured %}is-red{% endif %}" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.bottom_text != blank %}
      <div class="custom-mf-products__bottom-text">
        {{ section.settings.bottom_text }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-mf-products__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-mf-products__heading {
    margin: 0;
    text-align: center;
    font-family: Barlow, sans-serif;
    font-size: 50px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -1px;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-products__subheading {
    margin: 10px auto 40px;
    max-width: 700px;
    text-align: center;
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .section-{{ section.id }} .custom-mf-products__card {
    position: relative;
    overflow: hidden;
    padding: 20px;
    border: 1px solid rgba(18,18,18,.1);
    border-radius: 16px;
    background: {{ section.settings.card_bg }};
  }

  .section-{{ section.id }} .custom-mf-products__card.is-featured {
    border: 3px solid {{ section.settings.featured_border }};
  }

  .section-{{ section.id }} .custom-mf-products__badge {
    margin: 0 0 12px;
    padding: 10px;
    border-radius: 100px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    text-align: center;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 700;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .custom-mf-products__title {
    margin: 0;
    font-family: Barlow, sans-serif;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-products__subtitle {
    margin-top: 6px;
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-products__image {
    display: block;
    width: 100%;
    height: auto;
    margin: 14px 0;
  }

  .section-{{ section.id }} .custom-mf-products__price-row {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: end;
    gap: 0;
  }

  .section-{{ section.id }} .custom-mf-products__price {
    font-family: Assistant, Barlow, sans-serif;
    font-size: 35px;
    line-height: 1.3;
    font-weight: 700;
    color: {{ section.settings.price_color }};
  }

  .section-{{ section.id }} .custom-mf-products__compare {
    padding-left: 7px;
    padding-bottom: 7px;
    font-family: Assistant, Barlow, sans-serif;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 600;
    color: {{ section.settings.compare_color }};
  }

  .section-{{ section.id }} .custom-mf-products__savings {
    display: inline-block;
    margin: 8px 0 10px;
    padding: 8px 14px;
    border-radius: 100px;
    background: {{ section.settings.savings_bg }};
    color: {{ section.settings.savings_color }};
    font-size: 15px;
    line-height: 1.3;
  }

  .section-{{ section.id }} .custom-mf-products__features {
    list-style: none;
    padding: 0;
    margin: 0 0 15px;
  }

  .section-{{ section.id }} .custom-mf-products__features li {
    position: relative;
    margin-bottom: 10px;
    padding-left: 32px;
    font-family: Barlow, sans-serif;
    font-size: 16px;
    line-height: 1.3;
    color: {{ section.settings.feature_color }};
  }

  .section-{{ section.id }} .custom-mf-products__features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: -1px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: {{ section.settings.check_color }};
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
  }

  .section-{{ section.id }} .custom-mf-products__button {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    padding: 15px 20px;
    border-radius: 10px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    font-family: Barlow, sans-serif;
    font-size: 20px;
    line-height: 1.4;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 1px 1px 20px rgba(203,2,0,.1);
  }

  .section-{{ section.id }} .custom-mf-products__button.is-red {
    background: {{ section.settings.featured_button_bg }};
    color: {{ section.settings.featured_button_color }};
  }

  .section-{{ section.id }} .custom-mf-products__button:hover {
    opacity: .9;
  }

  .section-{{ section.id }} .custom-mf-products__bottom-text {
    margin-top: 22px;
    text-align: center;
    font-family: Assistant, Barlow, sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .custom-mf-products__heading {
      font-size: 32px;
    }

    .section-{{ section.id }} .custom-mf-products__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding-left: 20px;
      padding-right: 20px;
    }

    .section-{{ section.id }} .custom-mf-products__heading {
      font-size: 29px;
    }

    .section-{{ section.id }} .custom-mf-products__title {
      font-size: 29px;
    }

    .section-{{ section.id }} .custom-mf-products__price {
      font-size: 35px;
    }
  }
</style>

{% schema %}

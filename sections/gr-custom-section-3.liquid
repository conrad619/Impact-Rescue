<section class="custom-mf-story section-{{ section.id }}">
  <div class="custom-mf-story__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="custom-mf-story__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <div class="custom-mf-story__divider"></div>

    {% if section.settings.heading != blank %}
      <h2 class="custom-mf-story__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="custom-mf-story__grid">
      {% if section.settings.image != blank %}
        <div class="custom-mf-story__image-wrap">
          {{ section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              class: 'custom-mf-story__image',
              alt: section.settings.image_alt
          }}
        </div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-mf-story__text">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.quote != blank %}
      <div class="custom-mf-story__quote">
        {{ section.settings.quote }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-mf-story__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-mf-story__eyebrow {
    margin: 0;
    font-family: Barlow, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .custom-mf-story__divider {
    height: 2px;
    margin: 12px 0;
    background: transparent;
  }

  .section-{{ section.id }} .custom-mf-story__heading {
    margin: 0 0 22px;
    font-family: Barlow, sans-serif;
    font-size: 50px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -1px;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-story__grid {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 16px;
    align-items: center;
    margin-bottom: 22px;
  }

  .section-{{ section.id }} .custom-mf-story__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .section-{{ section.id }} .custom-mf-story__text {
    font-family: Barlow, sans-serif;
    font-size: 19px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-story__text p {
    margin: 0;
  }

  .section-{{ section.id }} .custom-mf-story__quote {
    padding: clamp(16px, 3vw, 24px);
    background: {{ section.settings.quote_bg }};
    border-left: 4px solid {{ section.settings.quote_border }};
    border-radius: 4px;
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.3;
    color: {{ section.settings.quote_color }};
  }

  .section-{{ section.id }} .custom-mf-story__quote p {
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .custom-mf-story__eyebrow,
    .section-{{ section.id }} .custom-mf-story__heading {
      text-align: center;
    }

    .section-{{ section.id }} .custom-mf-story__heading {
      font-size: 29px;
      letter-spacing: 0.6px;
    }

    .section-{{ section.id }} .custom-mf-story__text {
      font-size: 18px;
      line-height: 1.3;
    }
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding: 10px;
    }

    .section-{{ section.id }} .custom-mf-story__grid {
      grid-template-columns: 1fr;
    }

    .section-{{ section.id }} .custom-mf-story__heading {
      font-size: 29px;
      line-height: 1.3;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Story Image",
  "tag": "section",
  "class": "custom-story-image-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "What Happens When He Opens It"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "He Rolled His Eyes. Then He Tried It Once."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Grill Rescue brush on Weber grill"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Most guys who own a Weber think they've got cleaning figured out. A wire brush and some elbow grease, same as always. So when this shows up as a gift, the reaction is usually a polite “…thanks.”</p><p>Then they dip it in water, press it on the hot grates, and watch steam blast the grime off in under a minute. No scrubbing, no bristles, no mess. That's the moment the eye-roll turns into “where has this been my whole life.”</p>"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote box",
      "default": "<p><em>“Thought it was a gimmick. Cleaned my whole Weber in one pass, grates looked brand new. I've thrown out every wire brush in the garage.” Dave M., verified buyer</em></p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4f4f4f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "quote_bg",
      "label": "Quote background",
      "default": "#fff0f0"
    },
    {
      "type": "color",
      "id": "quote_border",
      "label": "Quote border",
      "default": "#cc0000"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#2a2a2a"
    }
  ],
  "presets": [
    {
      "name": "Custom Story Image"
    }
  ]
}
{% endschema %}
<style>
  #shopify-section-{{ section.id }} {
    --gr-trust-bg: {{ section.settings.background_color }};
    --gr-trust-text: {{ section.settings.text_color }};
    --gr-trust-accent: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .gr-auth-trust {
    background: var(--gr-trust-bg);
    color: var(--gr-trust-text);
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr));
    border-top: 1px solid rgba(255,255,255,.16);
    border-bottom: 1px solid rgba(255,255,255,.16);
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 112px;
    padding: 20px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__item + .gr-auth-trust__item {
    border-left: 1px solid rgba(255,255,255,.16);
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__fallback {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border: 2px solid var(--gr-trust-accent);
    border-radius: 50%;
    color: var(--gr-trust-accent);
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__heading {
    margin: 0 0 4px;
    color: inherit;
    font-size: .95rem;
    font-weight: 800;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .gr-auth-trust__text {
    margin: 0;
    font-size: .8rem;
    line-height: 1.35;
    opacity: .72;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gr-auth-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .gr-auth-trust__item:nth-child(3) {
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .gr-auth-trust__item:nth-child(n+3) {
      border-top: 1px solid rgba(255,255,255,.16);
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .gr-auth-trust__item {
      min-height: 96px;
      padding: 15px 10px;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .gr-auth-trust__icon,
    #shopify-section-{{ section.id }} .gr-auth-trust__fallback {
      width: 32px;
      height: 32px;
      flex-basis: 32px;
    }
  }
</style>

<section class="gr-auth-trust">
  <div class="container">
    <div class="gr-auth-trust__grid">
      {%- for block in section.blocks -%}
        <div class="gr-auth-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon
              | image_url: width: 100
              | image_tag:
                loading: 'lazy',
                class: 'gr-auth-trust__icon',
                widths: '50,75,100',
                sizes: '42px',
                alt: block.settings.heading
            }}
          {%- else -%}
            <span class="gr-auth-trust__fallback" aria-hidden="true">✓</span>
          {%- endif -%}

          <div>
            <h2 class="gr-auth-trust__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}
              <p class="gr-auth-trust__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GR Authenticity Trust",
  "tag": "section",
  "class": "shopify-section--gr-auth-trust",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ef3038"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Patented design"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "Built by the original brand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GR Authenticity Trust",
      "blocks": [
        { "type": "item", "settings": { "heading": "Created by a firefighter", "text": "Designed with safety first" } },
        { "type": "item", "settings": { "heading": "Patented construction", "text": "The original Grill Rescue design" } },
        { "type": "item", "settings": { "heading": "Replaceable cleaning head", "text": "Dishwasher-friendly care" } },
        { "type": "item", "settings": { "heading": "30-day guarantee", "text": "Official Grill Rescue support" } }
      ]
    }
  ]
}
{% endschema %}

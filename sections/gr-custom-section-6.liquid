<section class="custom-mf-faq section-{{ section.id }}">
  <div class="custom-mf-faq__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="custom-mf-faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="custom-mf-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="custom-mf-faq__cards">
      {% for block in section.blocks %}
        <div class="custom-mf-faq__card" {{ block.shopify_attributes }}>
          {% if block.settings.question != blank %}
            <div class="custom-mf-faq__question">
              {{ block.settings.question }}
            </div>
          {% endif %}

          {% if block.settings.answer != blank %}
            <div class="custom-mf-faq__answer">
              {{ block.settings.answer }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-mf-faq__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-mf-faq__eyebrow {
    margin: 0 0 12px;
    font-family: Barlow, sans-serif;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .custom-mf-faq__heading {
    margin: 0 0 24px;
    font-family: Barlow, sans-serif;
    font-size: 50px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -1px;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-faq__card {
    padding: 20px;
    margin-bottom: 19px;
    border-radius: 10px;
    background: {{ section.settings.card_bg }};
    box-shadow: 1px 1px 100px 5px rgba(18, 18, 18, 0.2);
  }

  .section-{{ section.id }} .custom-mf-faq__question {
    margin-bottom: 8px;
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
    color: {{ section.settings.question_color }};
  }

  .section-{{ section.id }} .custom-mf-faq__answer {
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    color: {{ section.settings.answer_color }};
  }

  .section-{{ section.id }} .custom-mf-faq__question p,
  .section-{{ section.id }} .custom-mf-faq__answer p {
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .custom-mf-faq__eyebrow,
    .section-{{ section.id }} .custom-mf-faq__heading {
      text-align: center;
    }

    .section-{{ section.id }} .custom-mf-faq__heading {
      font-size: 32px;
      letter-spacing: 0.6px;
    }
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding: 20px 10px;
    }

    .section-{{ section.id }} .custom-mf-faq__heading {
      font-size: 29px;
    }

    .section-{{ section.id }} .custom-mf-faq__answer {
      line-height: 1.3;
    }
  }
</style>

{% schema %}
{
  "name": "Custom FAQ Cards",
  "tag": "section",
  "class": "custom-faq-cards-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Before You Ask"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Quick Answers"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4f4f4f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "richtext",
          "id": "question",
          "label": "Question",
          "default": "<p><strong>Will it work on his Weber?</strong></p>"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. It's safe on porcelain-enameled, cast iron, stainless steel, and chrome grates, exactly what Weber grills use.</p>"
        }
      ]
    }
  ],
  "presets": [
    {

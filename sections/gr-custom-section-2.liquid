<section class="custom-mf-warning section-{{ section.id }}">
  <div class="custom-mf-warning__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="custom-mf-warning__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    <div class="custom-mf-warning__divider"></div>

    {% if section.settings.heading != blank %}
      <h2 class="custom-mf-warning__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="custom-mf-warning__text">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.alert_title != blank or section.settings.alert_text != blank %}
      <div class="custom-mf-warning__alert">
        {% if section.settings.alert_title != blank %}
          <p class="custom-mf-warning__alert-title">
            {{ section.settings.alert_icon }} {{ section.settings.alert_title }}
          </p>
        {% endif %}

        {% if section.settings.alert_text != blank %}
          <div class="custom-mf-warning__alert-body">
            {{ section.settings.alert_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.bottom_text != blank %}
      <div class="custom-mf-warning__text custom-mf-warning__bottom">
        {{ section.settings.bottom_text }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-mf-warning__eyebrow {
    margin: 0;
    font-family: Barlow, sans-serif;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__divider {
    width: 100%;
    height: 2px;
    margin: 12px 0;
    background: transparent;
  }

  .section-{{ section.id }} .custom-mf-warning__heading {
    margin: 0 0 22px;
    font-family: Barlow, sans-serif;
    font-size: 50px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -1px;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__text {
    margin-bottom: 17px;
    font-family: Barlow, sans-serif;
    font-size: 19px;
    line-height: 1.4;
    font-weight: 400;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__text p {
    margin: 0;
  }

  .section-{{ section.id }} .custom-mf-warning__alert {
    margin-bottom: 15px;
    padding: clamp(16px, 3vw, 24px);
    background: {{ section.settings.alert_bg }};
    border-left: 4px solid {{ section.settings.alert_border }};
    border-radius: 4px;
    font-family: Barlow, sans-serif;
  }

  .section-{{ section.id }} .custom-mf-warning__alert-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 700;
    color: {{ section.settings.alert_title_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__alert-body {
    margin: 0;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 400;
    color: {{ section.settings.alert_text_color }};
  }

  .section-{{ section.id }} .custom-mf-warning__alert-body p {
    margin: 0;
  }

  .section-{{ section.id }} .custom-mf-warning__bottom {
    margin-bottom: 0;
  }

  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .custom-mf-warning__eyebrow,
    .section-{{ section.id }} .custom-mf-warning__heading {
      text-align: center;
    }

    .section-{{ section.id }} .custom-mf-warning__heading {
      font-size: 29px;
      letter-spacing: 0.6px;
    }

    .section-{{ section.id }} .custom-mf-warning__text {
      font-size: 18px;
      line-height: 1.3;
    }
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding: 10px;
    }

    .section-{{ section.id }} .custom-mf-warning__heading {
      font-size: 29px;
      line-height: 1.3;
    }

    .section-{{ section.id }} .custom-mf-warning__divider {
      height: 1px;
      margin: 5px 0;
    }

    .section-{{ section.id }} .custom-mf-warning__text {
      font-size: 18px;
      letter-spacing: 0.6px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Warning",
  "tag": "section",
  "class": "custom-warning-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Hidden Danger In Almost Every Garage"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "That Wire Brush in His Garage Is a Hospital Visit Waiting to Happen"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Here's what most Weber owners don't know: those tiny wire bristles snap off, stick to the grates, and end up in the food. Every year, more than <strong>1,000 people land in the ER</strong> after swallowing one. And in early 2026, regulators recalled <strong>13 million</strong> wire grill brushes, including major Weber brush models.</p>"
    },
    {
      "type": "text",
      "id": "alert_icon",
      "label": "Alert icon",
      "default": "⚠️"
    },
    {
      "type": "inline_richtext",
      "id": "alert_title",
      "label": "Alert title",
      "default": "Safety Warning"
    },
    {
      "type": "richtext",
      "id": "alert_text",
      "label": "Alert text",
      "default": "<p>A single detached wire bristle can lodge in the throat or stomach and require surgery. You'd never see it on the burger.</p>"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "<p>He spent good money on that Weber and treats it like family. The brush he's cleaning it with shouldn't be the most dangerous thing in the backyard.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4f4f4f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "alert_bg",
      "label": "Alert background",
      "default": "#fff0f0"
    },
    {
      "type": "color",
      "id": "alert_border",
      "label": "Alert border",
      "default": "#cc0000"
    },
    {
      "type": "color",
      "id": "alert_title_color",
      "label": "Alert title color",
      "default": "#cc0000"
    },
    {
      "type": "color",
      "id": "alert_text_color",
      "label": "Alert text color",
      "default": "#2a2a2a"
    }
  ],
  "presets": [
    {
      "name": "Custom Warning"
    }
  ]
}
{% endschema %}
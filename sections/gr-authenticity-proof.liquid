<style>
  #shopify-section-{{ section.id }} {
    --gr-proof-bg: {{ section.settings.background_color }};
    --gr-proof-card: {{ section.settings.card_color }};
    --gr-proof-text: {{ section.settings.text_color }};
    --gr-proof-red: {{ section.settings.accent_color }};
    --gr-proof-radius: {{ section.settings.corner_radius }}px;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof {
    background: var(--gr-proof-bg);
    color: var(--gr-proof-text);
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__header {
    max-width: 780px;
    margin: 0 auto 36px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__eyebrow {
    margin: 0 0 10px;
    color: var(--gr-proof-red);
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__heading {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4.5rem);
    line-height: .96;
    letter-spacing: -.045em;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__text {
    margin-top: 16px;
    opacity: .72;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--gr-proof-radius);
    background: var(--gr-proof-card);
    box-shadow: 0 12px 38px rgba(0,0,0,.08);
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__media {
    aspect-ratio: 4 / 3;
    background: #ececec;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__media img,
  #shopify-section-{{ section.id }} .gr-auth-proof__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__stars {
    margin-bottom: 12px;
    color: var(--gr-proof-red);
    letter-spacing: .12em;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__quote {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__name {
    margin-top: auto;
    padding-top: 18px;
    font-size: .82rem;
    font-weight: 800;
    opacity: .62;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__cta {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .gr-auth-proof__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border-radius: 8px;
    color: #fff;
    background: var(--gr-proof-red);
    font-weight: 850;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .gr-auth-proof__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .gr-auth-proof__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 8px;
    }

    #shopify-section-{{ section.id }} .gr-auth-proof__grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .gr-auth-proof__card {
      min-width: 84vw;
      scroll-snap-align: start;
    }
  }
</style>

<section class="section gr-auth-proof">
  <div class="container">
    <header class="gr-auth-proof__header">
      {%- if section.settings.eyebrow != blank -%}<p class="gr-auth-proof__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 gr-auth-proof__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="gr-auth-proof__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="gr-auth-proof__grid">
      {%- for block in section.blocks -%}
        <article class="gr-auth-proof__card" {{ block.shopify_attributes }}>
          <div class="gr-auth-proof__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '350,550,750,1000',
                  sizes: '(max-width: 599px) 84vw, (max-width: 899px) 50vw, 33vw',
                  alt: block.settings.image_alt
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="gr-auth-proof__content">
            <div class="gr-auth-proof__stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="gr-auth-proof__quote">“{{ block.settings.quote }}”</blockquote>
            <div class="gr-auth-proof__name">{{ block.settings.name }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="gr-auth-proof__cta">
        <a class="button gr-auth-proof__button" href="{{ section.settings.button_link | default: '#gr-auth-buy' }}">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GR Social Proof",
  "tag": "section",
  "class": "shopify-section--gr-auth-proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The original has a following" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thousands chose the real Grill Rescue." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use customer photos, review graphics, press mentions, or campaign creative here.</p>" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop the original" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f3f0ec" },
    { "type": "color", "id": "card_color", "label": "Card color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#d91f26" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Grill Rescue customer" },
        { "type": "textarea", "id": "quote", "label": "Review quote", "default": "Add an approved customer quote here." },
        { "type": "text", "id": "name", "label": "Customer or source", "default": "Verified customer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GR Social Proof",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

<section class="custom-mf-steps section-{{ section.id }}">
  <div class="custom-mf-steps__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="custom-mf-steps__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <div class="custom-mf-steps__divider"></div>

    {% if section.settings.heading != blank %}
      <h2 class="custom-mf-steps__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="custom-mf-steps__red-line"></div>

    <div class="custom-mf-steps__grid">
      {% if section.settings.image != blank %}
        <div class="custom-mf-steps__image-wrap">
          {{ section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              class: 'custom-mf-steps__image',
              alt: section.settings.image_alt
          }}
        </div>
      {% endif %}

      <div class="custom-mf-steps__cards">
        {% for block in section.blocks %}
          <div class="custom-mf-steps__card" {{ block.shopify_attributes }}>
            <div class="custom-mf-steps__card-heading">
              <span class="custom-mf-steps__number">{{ forloop.index }}</span>
              <span>{{ block.settings.title }}</span>
            </div>

            {% if block.settings.text != blank %}
              <div class="custom-mf-steps__card-text">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="custom-mf-steps__button-wrap">
        <a class="custom-mf-steps__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .custom-mf-steps__eyebrow {
    margin: 0;
    font-family: Barlow, sans-serif;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__divider {
    height: 2px;
    margin: 12px 0;
  }

  .section-{{ section.id }} .custom-mf-steps__heading {
    margin: 0 0 10px;
    font-family: Barlow, sans-serif;
    font-size: 50px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -1px;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__red-line {
    width: 100px;
    height: 5px;
    margin: 0 0 20px;
    background: {{ section.settings.accent_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: center;
    margin-bottom: 20px;
  }

  .section-{{ section.id }} .custom-mf-steps__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .section-{{ section.id }} .custom-mf-steps__card {
    padding: 20px;
    margin-bottom: 15px;
    background: {{ section.settings.card_bg }};
    border-radius: 10px;
    box-shadow: 1px 1px 100px 5px rgba(18, 18, 18, 0.2);
  }

  .section-{{ section.id }} .custom-mf-steps__card:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .custom-mf-steps__card-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
    font-family: Barlow, sans-serif;
    font-size: 30px;
    line-height: 1.3;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: 50%;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    font-size: 22px;
    line-height: 1;
  }

  .section-{{ section.id }} .custom-mf-steps__card-text {
    font-family: Barlow, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-steps__card-text p {
    margin: 0;
  }

  .section-{{ section.id }} .custom-mf-steps__button-wrap {
    text-align: center;
  }

  .section-{{ section.id }} .custom-mf-steps__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 44px;
    border-radius: 10px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    font-family: Barlow, sans-serif;
    font-size: 22px;
    line-height: 1.4;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 1px 1px 20px rgba(203, 2, 0, 0.15);
    transition: background 0.2s ease;
  }

  .section-{{ section.id }} .custom-mf-steps__button:hover {
    background: {{ section.settings.button_hover_bg }};
  }

  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .custom-mf-steps__eyebrow,
    .section-{{ section.id }} .custom-mf-steps__heading {
      text-align: center;
    }

    .section-{{ section.id }} .custom-mf-steps__heading {
      font-size: 29px;
      letter-spacing: 0.6px;
    }

    .section-{{ section.id }} .custom-mf-steps__red-line {
      height: 2px;
      margin-left: auto;
      margin-right: auto;
    }

    .section-{{ section.id }} .custom-mf-steps__card-heading {
      font-size: 16px;
    }

    .section-{{ section.id }} .custom-mf-steps__card-text {
      font-size: 14px;
      line-height: 1.8;
    }

    .section-{{ section.id }} .custom-mf-steps__button {
      width: 100%;
      font-size: 29px;
      padding: 16px 10px;
    }
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding: 10px;
    }

    .section-{{ section.id }} .custom-mf-steps__grid {
      grid-template-columns: 1fr;
    }

    .section-{{ section.id }} .custom-mf-steps__heading {
      font-size: 29px;
    }

    .section-{{ section.id }} .custom-mf-steps__card {
      margin-bottom: 10px;
    }

    .section-{{ section.id }} .custom-mf-steps__card-heading {
      font-size: 14px;
      line-height: 1.8;
    }

    .section-{{ section.id }} .custom-mf-steps__card-text {
      font-size: 18px;
    }

    .section-{{ section.id }} .custom-mf-steps__button {
      font-size: 18px;
      padding: 15px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Steps",
  "tag": "section",
  "class": "custom-steps-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Firefighter's Solution"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Steam Does the Scrubbing. He Just Holds It."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image or GIF"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Grill Rescue steam cleaning a Weber grill"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Gift He'll Actually Use →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4f4f4f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#cc0000"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#cb0200"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#9e0401"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Step title",
          "default": "DIP"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step text",
          "default": "<p><strong>Dunk the aramid-fiber head in water. It's the same material in firefighter gear.</strong></p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "DIP",
            "text": "<p><strong>Dunk the aramid-fiber head in water. It's the same material in firefighter gear.</strong></p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "PRESS",
            "text": "<p><strong>Press it on grates at 400 to 600°F. Steam erupts and lifts grease instantly.</strong></p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "DONE",
            "text": "<p><strong>Spotless grates in 60 seconds. Head pops off, goes in the dishwasher.</strong></p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
    <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Comparison Table</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  .compare-table * { box-sizing: border-box; }

  .compare-table {
    width: 100%;
    font-family: 'Barlow', sans-serif;
    border-collapse: collapse;
    border-radius: 12px;
    overflow: hidden;
    font-size: 15px;
    border: 1px solid #e0e0e0;
  }

  /* Header row */
  .compare-table thead tr th {
    padding: clamp(10px, 2vw, 20px) clamp(8px, 2vw, 24px);
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-right: 1px solid #e5e5e5;
  }

  .compare-table thead tr th:last-child { border-right: none; }

  .compare-table thead tr th:first-child {
    background: #1a1a1a;
    text-align: left;
    color: transparent;
  }

  .compare-table thead tr th.col-us {
    background: #cc0000;
    color: #ffffff;
  }

  .compare-table thead tr th.col-them {
    background: #2a2a2a;
    color: #ffffff;
  }

  /* Body rows */
  .compare-table tbody tr:nth-child(odd) td { background: #ffffff; }
  .compare-table tbody tr:nth-child(even) td { background: #f4f4f4; }

  .compare-table tbody tr td {
    padding: clamp(10px, 2vw, 20px) clamp(8px, 2vw, 24px);
    border-bottom: 1px solid #e5e5e5;
    border-right: 1px solid #e0e0e0;
    text-align: center;
    vertical-align: middle;
  }

  .compare-table tbody tr td:last-child { border-right: none; }

  .compare-table tbody tr td:first-child {
    text-align: left;
    font-weight: 700;
    color: #1a1a2e;
  }

  .compare-table tbody tr:last-child td { border-bottom: none; }

  /* Win / Lose values */
  .compare-table .val-win {
    color: #16a34a;
    font-weight: 700;
  }

  .compare-table .val-lose {
    color: #cc0000;
    font-weight: 700;
  }

  /* Mobile: keep table layout, only reduce padding */
  @media (max-width: 600px) {
    .compare-table { border-radius: 8px; }
    .compare-table thead tr th { padding: 10px 8px; }
    .compare-table tbody tr td { padding: 10px 8px; }
  }

  @media (max-width: 380px) {
    .compare-table thead tr th { padding: 8px 6px; }
    .compare-table tbody tr td { padding: 8px 6px; }
  }
</style>
</head>
<body>

<table class="compare-table">
  <thead>
    <tr>
      <th></th>
      <th class="col-us">Grill Rescue</th>

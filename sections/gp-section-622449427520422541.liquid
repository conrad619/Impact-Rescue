      <td><span class="val-win">&#10003; About 60 Sec</span></td>
      <td><span class="val-lose">&#10007; Several Min</span></td>
    </tr>
    <tr>
      <td>Dishwasher safe</td>
      <td><span class="val-win">&#10003; Yes</span></td>
      <td><span class="val-lose">&#10007; No</span></td>
    </tr>
    <tr>
      <td>Lasts for years</td>
      <td><span class="val-win">&#10003; Replaceable Heads</span></td>
      <td><span class="val-lose">&#10007; Toss It Out</span></td>
    </tr>
  </tbody>
</table>

</body>
</html>

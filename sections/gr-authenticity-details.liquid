<style>
  #shopify-section-{{ section.id }} {
    --gr-details-bg: {{ section.settings.background_color }};
    --gr-details-text: {{ section.settings.text_color }};
    --gr-details-red: {{ section.settings.accent_color }};
    --gr-details-card: {{ section.settings.card_color }};
    --gr-details-radius: {{ section.settings.corner_radius }}px;
  }

  #shopify-section-{{ section.id }} .gr-auth-details {
    background: var(--gr-details-bg);
    color: var(--gr-details-text);
  }

  #shopify-section-{{ section.id }} .gr-auth-details__header {
    max-width: 800px;
    margin-bottom: clamp(36px, 6vw, 70px);
  }

  #shopify-section-{{ section.id }} .gr-auth-details__eyebrow,
  #shopify-section-{{ section.id }} .gr-auth-details__item-eyebrow {
    margin: 0 0 12px;
    color: var(--gr-details-red);
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__heading {
    margin: 0;
    font-size: clamp(2.3rem, 4.5vw, 5rem);
    line-height: .96;
    letter-spacing: -.05em;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__header-copy {
    margin-top: 18px;
    max-width: 680px;
    font-size: 1.05rem;
    opacity: .72;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__list {
    display: grid;
    gap: clamp(42px, 7vw, 90px);
  }

  #shopify-section-{{ section.id }} .gr-auth-details__item {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(320px, .98fr);
    gap: clamp(28px, 6vw, 82px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__item--reverse .gr-auth-details__media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--gr-details-radius);
    background: #ececec;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__media img,
  #shopify-section-{{ section.id }} .gr-auth-details__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__number {
    position: absolute;
    top: 18px;
    left: 18px;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--gr-details-red);
    font-size: 1.1rem;
    font-weight: 900;
    box-shadow: 0 8px 24px rgba(0,0,0,.2);
  }

  #shopify-section-{{ section.id }} .gr-auth-details__content {
    padding: clamp(4px, 2vw, 24px);
  }

  #shopify-section-{{ section.id }} .gr-auth-details__item-heading {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 3.5vw, 3.8rem);
    line-height: .98;
    letter-spacing: -.045em;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__text {
    margin-top: 18px;
    font-size: 1.02rem;
    line-height: 1.6;
    opacity: .76;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__callout {
    display: flex;
    gap: 11px;
    margin-top: 22px;
    padding: 16px 18px;
    border-radius: 10px;
    background: var(--gr-details-card);
    font-weight: 750;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .gr-auth-details__callout::before {
    content: "✓";
    color: var(--gr-details-red);
    font-weight: 950;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block {
    padding: var(--gr-ntf-padding-top) 0 var(--gr-ntf-padding-bottom);
    color: var(--gr-ntf-heading-color);
    background: var(--gr-ntf-bg);
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__inner {
    max-width: var(--gr-ntf-max-width);
    margin: 0 auto;
    /* padding: 0 20px; */
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__header {
    margin-bottom: var(--gr-ntf-text-margin);
    text-align: var(--gr-ntf-alignment);
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__eyebrow {
    display: block;
    margin-bottom: 8px;
    color: var(--gr-ntf-eyebrow-color);
    font-family: var(--gr-ntf-eyebrow-font);
    font-size: var(--gr-ntf-eyebrow-size);
    font-weight: var(--gr-ntf-eyebrow-weight);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__heading {
    margin: 0 0 var(--gr-ntf-heading-margin);
    color: var(--gr-ntf-heading-color);
    font-family: var(--gr-ntf-heading-font);
    font-size: var(--gr-ntf-heading-size);
    font-weight: var(--gr-ntf-heading-weight);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__subtext {
    max-width: 640px;
    margin: 0 auto;
    color: var(--gr-ntf-subtext-color);
    font-family: var(--gr-ntf-subtext-font);
    font-size: var(--gr-ntf-subtext-size);
    font-weight: var(--gr-ntf-subtext-weight);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gr-ntf-gap);
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__frame {
    width: 100%;
    overflow: hidden;
    border-radius: var(--gr-ntf-radius);
    background: #f0f0f0;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__frame img,
  #shopify-section-{{ section.id }} .gr-ntf-block__placeholder {
    display: flex;
    width: 100%;
    height: var(--gr-ntf-height);
    align-items: center;
    justify-content: center;
    object-fit: var(--gr-ntf-fit);
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__placeholder {
    color: #999;
    font-size: 14px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__caption {
    margin: 10px 0 0;
    color: var(--gr-ntf-caption-color);
    font-family: var(--gr-ntf-caption-font);
    font-size: var(--gr-ntf-caption-size);
    font-weight: var(--gr-ntf-caption-weight);
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .gr-ntf-block__dots {
    display: none;
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .gr-auth-details__item {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .gr-auth-details__item--reverse .gr-auth-details__media {
      order: 0;
    }

    #shopify-section-{{ section.id }} .gr-auth-details__content {
      padding: 0 4px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gr-ntf-block__track {
      display: flex;
      gap: var(--gr-ntf-gap);
      padding-bottom: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__track::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__item {
      flex: 0 0 var(--gr-ntf-mobile-width);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__frame img,
    #shopify-section-{{ section.id }} .gr-ntf-block__placeholder {
      height: var(--gr-ntf-mobile-height);
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 14px;
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--gr-ntf-heading-color);
      cursor: pointer;
      opacity: .25;
      transition: opacity .3s;
    }

    #shopify-section-{{ section.id }} .gr-ntf-block__dot.is-active {
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .gr-ntf-block__heading {
      font-size: var(--gr-ntf-heading-size-desktop);
    }
  }
</style>

<section class="section gr-auth-details">
  <div class="container">
    <header class="gr-auth-details__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gr-auth-details__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h1 gr-auth-details__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="gr-auth-details__header-copy rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="gr-auth-details__list">
      {%- assign detail_number = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'detail' -%}
            {%- assign detail_number = detail_number | plus: 1 -%}
        <article class="gr-auth-details__item{% if block.settings.image_position == 'right' %} gr-auth-details__item--reverse{% endif %}" {{ block.shopify_attributes }}>
          <div class="gr-auth-details__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1500
                | image_tag:
                  loading: 'lazy',
                  widths: '450,700,900,1200,1500',
                  sizes: '(max-width: 899px) 100vw, 52vw',
                  alt: block.settings.heading
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="gr-auth-details__number">{{ detail_number }}</span>
          </div>

          <div class="gr-auth-details__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="gr-auth-details__item-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h3 class="gr-auth-details__item-heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="gr-auth-details__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.callout != blank -%}
              <div class="gr-auth-details__callout">{{ block.settings.callout }}</div>
            {%- endif -%}
          </div>
        </article>
          {%- when 'never_trust_fakes' -%}
            <div
              class="gr-ntf-block"
              id="gr-ntf-{{ section.id }}-{{ block.id }}"
              style="
                --gr-ntf-bg: {{ block.settings.section_bg_color }};
                --gr-ntf-padding-top: {{ block.settings.section_padding_top }}px;
                --gr-ntf-padding-bottom: {{ block.settings.section_padding_bottom }}px;
                --gr-ntf-max-width: {{ block.settings.section_max_width }}px;
                --gr-ntf-alignment: {{ block.settings.text_alignment }};
                --gr-ntf-text-margin: {{ block.settings.text_bottom_margin }}px;
                --gr-ntf-eyebrow-color: {{ block.settings.eyebrow_color }};
                --gr-ntf-eyebrow-size: {{ block.settings.eyebrow_font_size }}px;
                --gr-ntf-eyebrow-weight: {{ block.settings.eyebrow_font_weight }};
                --gr-ntf-eyebrow-font: {{ block.settings.eyebrow_font_family }};
                --gr-ntf-heading-color: {{ block.settings.heading_color }};
                --gr-ntf-heading-size: {{ block.settings.heading_font_size }}px;
                --gr-ntf-heading-size-desktop: {{ block.settings.heading_font_size_desktop }}px;
                --gr-ntf-heading-weight: {{ block.settings.heading_font_weight }};
                --gr-ntf-heading-font: {{ block.settings.heading_font_family }};
                --gr-ntf-heading-margin: {{ block.settings.heading_bottom_margin }}px;
                --gr-ntf-subtext-color: {{ block.settings.subtext_color }};
                --gr-ntf-subtext-size: {{ block.settings.subtext_font_size }}px;
                --gr-ntf-subtext-weight: {{ block.settings.subtext_font_weight }};
                --gr-ntf-subtext-font: {{ block.settings.subtext_font_family }};
                --gr-ntf-gap: {{ block.settings.gif_gap }}px;
                --gr-ntf-height: {{ block.settings.gif_height }}px;
                --gr-ntf-fit: {{ block.settings.gif_object_fit }};
                --gr-ntf-radius: {{ block.settings.gif_border_radius }}px;
                --gr-ntf-mobile-width: {{ block.settings.mobile_gif_width }}%;
                --gr-ntf-mobile-height: {{ block.settings.mobile_gif_height }}px;
                --gr-ntf-caption-color: {{ block.settings.caption_color }};
                --gr-ntf-caption-size: {{ block.settings.caption_font_size }}px;
                --gr-ntf-caption-weight: {{ block.settings.caption_font_weight }};
                --gr-ntf-caption-font: {{ block.settings.caption_font_family }};
              "
              {{ block.shopify_attributes }}
            >
              <div class="gr-ntf-block__inner">
                <div class="gr-ntf-block__header">
                  {%- if block.settings.eyebrow_text != blank -%}
                    <span class="gr-ntf-block__eyebrow">{{ block.settings.eyebrow_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.heading_text != blank -%}
                    <{{ block.settings.heading_tag }} class="gr-ntf-block__heading">{{ block.settings.heading_text }}</{{ block.settings.heading_tag }}>
                  {%- endif -%}
                  {%- if block.settings.subtext != blank -%}
                    <p class="gr-ntf-block__subtext">{{ block.settings.subtext }}</p>
                  {%- endif -%}
                </div>

                <div class="gr-ntf-block__track" data-ntf-track>
                  {%- for i in (1..3) -%}
                    {%- assign image_key = 'gif_image_' | append: i -%}
                    {%- assign caption_key = 'gif_caption_' | append: i -%}
                    {%- assign gif_image = block.settings[image_key] -%}
                    {%- assign gif_caption = block.settings[caption_key] -%}
                    <div class="gr-ntf-block__item">
                      <div class="gr-ntf-block__frame">
                        {%- if gif_image != blank -%}
                          {{ gif_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: gif_caption }}
                        {%- else -%}
                          <div class="gr-ntf-block__placeholder">Upload a GIF</div>
                        {%- endif -%}
                      </div>
                      {%- if gif_caption != blank -%}
                        <p class="gr-ntf-block__caption">{{ gif_caption }}</p>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>

                <div class="gr-ntf-block__dots">
                  {%- for i in (1..3) -%}
                    <button class="gr-ntf-block__dot{% if forloop.first %} is-active{% endif %}" type="button" data-index="{{ forloop.index0 }}" aria-label="Go to GIF {{ forloop.index }}"></button>
                  {%- endfor -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('.gr-ntf-block').forEach((container) => {
      const track = container.querySelector('[data-ntf-track]');
      const dots = container.querySelectorAll('.gr-ntf-block__dot');
      if (!track || !dots.length || container.dataset.carouselReady === 'true') return;

      container.dataset.carouselReady = 'true';
      const updateDots = () => {
        const item = track.firstElementChild;
        if (!item) return;
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        const index = Math.round(track.scrollLeft / (item.offsetWidth + gap));
        dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index));
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const item = track.children[Number(dot.dataset.index)];
          if (item) track.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
        });
      });

      track.addEventListener('scroll', updateDots, { passive: true });
    });
  })();
</script>


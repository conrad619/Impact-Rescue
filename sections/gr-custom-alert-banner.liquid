{% if section.settings.show_banner %}
  <section class="custom-mf-alert section-{{ section.id }}">
    {% if section.settings.banner_link != blank %}
      <a href="{{ section.settings.banner_link }}" class="custom-mf-alert__link">
    {% endif %}

      <div class="custom-mf-alert__inner">
        {% if section.settings.icon != blank %}
          <span class="custom-mf-alert__icon">{{ section.settings.icon }}</span>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="custom-mf-alert__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.banner_link != blank %}
          {% if section.settings.button_label != blank %}
            <span class="custom-mf-alert__button">
              {{ section.settings.button_label }}
            </span>
          {% endif %}
        {% endif %}
      </div>

    {% if section.settings.banner_link != blank %}
      </a>
    {% endif %}
  </section>
{% endif %}

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-mf-alert__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .section-{{ section.id }} .custom-mf-alert__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    font-family: Barlow, sans-serif;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.3;
    font-weight: 700;
  }

  .section-{{ section.id }} .custom-mf-alert__text p {
    margin: 0;
  }

  .section-{{ section.id }} .custom-mf-alert__icon {
    flex-shrink: 0;
  }

  .section-{{ section.id }} .custom-mf-alert__button {
    display: inline-flex;
    padding: 6px 14px;
    border-radius: 100px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    font-size: 14px;
    white-space: nowrap;
  }

  @media screen and (max-width: 767px) {
    .section-{{ section.id }} .custom-mf-alert__inner {
      flex-wrap: wrap;
      gap: 6px;
      padding: {{ section.settings.mobile_padding_y }}px 12px;
      font-size: {{ section.settings.mobile_font_size }}px;
    }

    .section-{{ section.id }} .custom-mf-alert__button {
      font-size: 12px;
      padding: 5px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Alert Banner",
  "tag": "section",
  "class": "custom-alert-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "🔥"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Banner text",
      "default": "<p>Father’s Day Sale: Save up to 50% today only</p>"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Desktop vertical padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_padding_y",
      "label": "Mobile vertical padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 11,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#cb0200"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffcd5d"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#151515"
    }
  ],
  "presets": [
    {
      "name": "Custom Alert Banner"
    }
  ]
}
{% endschema %}
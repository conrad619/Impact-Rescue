{%- liquid
  assign chosen_product = section.settings.product
  if chosen_product == blank
    assign chosen_product = all_products['grill-brush-w-scraper']
  endif

  if chosen_product != blank
    assign selected_variant = chosen_product.selected_or_first_available_variant
    assign product_form_id = 'gr-auth-hero-form-' | append: section.id
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --gr-red: {{ section.settings.accent_color }};
    --gr-ink: {{ section.settings.text_color }};
    --gr-bg: {{ section.settings.background_color }};
    --gr-card: {{ section.settings.card_color }};
    --gr-radius: {{ section.settings.corner_radius }}px;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero {
    background: var(--gr-bg);
    color: var(--gr-ink);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__media {
    position: relative;
    min-height: 620px;
    border-radius: var(--gr-radius);
    overflow: hidden;
    background: #ececec;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__media img,
  #shopify-section-{{ section.id }} .gr-auth-hero__media svg {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(0,0,0,.38));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__media-label {
    position: absolute;
    z-index: 1;
    left: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border-radius: 999px;
    color: #fff;
    background: rgba(0,0,0,.72);
    backdrop-filter: blur(8px);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__card {
    background: var(--gr-card);
    border-radius: var(--gr-radius);
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 0 24px 70px rgba(0,0,0,.10);
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__eyebrow {
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    margin-bottom: 18px;
    color: #fff;
    background: var(--gr-red);
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.6rem, 5.2vw, 5.8rem);
    line-height: .92;
    letter-spacing: -.055em;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__copy {
    margin-top: 22px;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
    margin: 24px 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__proof li {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: .92rem;
    font-weight: 650;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__proof li::before {
    content: "✓";
    display: grid;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--gr-red);
    font-size: 12px;
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__product {
    border-top: 1px solid rgba(0,0,0,.11);
    padding-top: 22px;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__product-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__product-title {
    margin: 0 0 3px;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__rating {
    font-size: .84rem;
    opacity: .76;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__price {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 8px;
    white-space: nowrap;
    font-size: 1.25rem;
    font-weight: 850;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__compare {
    font-size: .9rem;
    font-weight: 500;
    opacity: .55;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__form-grid {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__field {
    width: 100%;
    min-height: 52px;
    padding: 0 14px;
    border: 1px solid rgba(0,0,0,.2);
    border-radius: 8px;
    background: #fff;
    color: #111;
    font: inherit;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__variant {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__button {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 8px;
    color: #fff;
    background: var(--gr-red);
    font: inherit;
    font-weight: 850;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .18s ease, filter .18s ease;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__button:hover {
    filter: brightness(.92);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__button[disabled] {
    opacity: .45;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .gr-auth-hero__microcopy {
    margin: 10px 0 0;
    text-align: center;
    font-size: .78rem;
    opacity: .66;
  }

  #shopify-section-{{ section.id }} .shopify-payment-button {
    margin-top: 10px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gr-auth-hero__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .gr-auth-hero__media {
      min-height: 520px;
    }

    #shopify-section-{{ section.id }} .gr-auth-hero__title {
      max-width: 14ch;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .gr-auth-hero__media {
      min-height: 430px;
      border-radius: calc(var(--gr-radius) * .7);
    }

    #shopify-section-{{ section.id }} .gr-auth-hero__card {
      border-radius: calc(var(--gr-radius) * .7);
      padding: 24px 18px;
    }

    #shopify-section-{{ section.id }} .gr-auth-hero__proof {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="section gr-auth-hero">
  <div class="container">
    <div class="gr-auth-hero__grid">
      <div class="gr-auth-hero__media">
        {%- if section.settings.desktop_image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 699px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
              >
            {%- endif -%}
            {{ section.settings.desktop_image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '600,900,1200,1500,1800',
                sizes: '(max-width: 989px) 100vw, 58vw',
                alt: section.settings.image_alt
            }}
          </picture>
        {%- elsif chosen_product != blank and chosen_product.featured_image != blank -%}
          {{ chosen_product.featured_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600,900,1200,1500,1800',
              sizes: '(max-width: 989px) 100vw, 58vw',
              alt: chosen_product.title
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if section.settings.media_label != blank -%}
          <div class="gr-auth-hero__media-label">{{ section.settings.media_label }}</div>
        {%- endif -%}
      </div>

      <div class="gr-auth-hero__card">
        {%- if section.settings.eyebrow != blank -%}
          <div class="gr-auth-hero__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        <h1 class="h1 gr-auth-hero__title">{{ section.settings.heading }}</h1>

        {%- if section.settings.text != blank -%}
          <div class="gr-auth-hero__copy rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <ul class="gr-auth-hero__proof" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>

        {%- if chosen_product != blank -%}
          <div class="gr-auth-hero__product">
            <div class="gr-auth-hero__product-row">
              <div>
                <h2 class="gr-auth-hero__product-title">{{ chosen_product.title }}</h2>
                {%- if section.settings.rating_text != blank -%}
                  <div class="gr-auth-hero__rating">{{ section.settings.rating_text }}</div>
                {%- endif -%}
              </div>

              <div class="gr-auth-hero__price" data-gr-price-wrap>
                <span data-gr-price>{{ selected_variant.price | money }}</span>
                <s class="gr-auth-hero__compare" data-gr-compare {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>
                  {{ selected_variant.compare_at_price | money }}
                </s>
              </div>
            </div>

            {%- form 'product', chosen_product, id: product_form_id, is: 'product-form' -%}
              <div class="gr-auth-hero__form-grid">
                {%- if chosen_product.variants.size > 1 -%}
                  <select class="gr-auth-hero__field gr-auth-hero__variant" name="id" aria-label="Choose an option" data-gr-variant-select>
                    {%- for variant in chosen_product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        data-price="{{ variant.price | money | escape }}"
                        data-compare="{{ variant.compare_at_price | money | escape }}"
                        data-has-compare="{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %}"
                        {% if variant == selected_variant %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ selected_variant.id }}">
                {%- endif -%}

                <input
                  class="gr-auth-hero__field"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  aria-label="Quantity"
                >

                <button class="button gr-auth-hero__button" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
                  {%- if selected_variant.available -%}
                    {{ section.settings.button_text }}
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </button>
              </div>

              {%- if section.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endform -%}

            {%- if section.settings.microcopy != blank -%}
              <p class="gr-auth-hero__microcopy">{{ section.settings.microcopy }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          <p>Select a product in this section's settings.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.grHeroReady === 'true') return;
    section.dataset.grHeroReady = 'true';

    const select = section.querySelector('[data-gr-variant-select]');
    const price = section.querySelector('[data-gr-price]');
    const compare = section.querySelector('[data-gr-compare]');

    if (!select || !price || !compare) return;

    select.addEventListener('change', () => {
      const option = select.options[select.selectedIndex];
      price.textContent = option.dataset.price || '';
      compare.textContent = option.dataset.compare || '';
      compare.hidden = option.dataset.hasCompare !== 'true';
    });
  })();
</script>

{% schema %}
{
  "name": "GR Authenticity Hero",
  "tag": "section",
  "class": "shopify-section--gr-auth-hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Authentic Grill Rescue scraper brush"
    },
    {
      "type": "text",
      "id": "media_label",
      "label": "Image label",
      "default": "The original Grill Rescue"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real vs. fake"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don’t get fooled by a fake."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Copycat brushes can look similar in a listing. The difference is in the materials, construction, performance, and support behind the product.</p>"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating or proof text",
      "default": "★★★★★ Over 12,000 5-star reviews"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add-to-cart text",
      "default": "Get the real Grill Rescue"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Under-button text",
      "default": "Every purchase helps support first responders."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#d91f26"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f4f1ed"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof point",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Firefighter-designed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GR Authenticity Hero",
      "blocks": [
        { "type": "proof", "settings": { "text": "The original bristle-free design" } },
        { "type": "proof", "settings": { "text": "Patented construction" } },
        { "type": "proof", "settings": { "text": "Premium aramid-fiber head" } },
        { "type": "proof", "settings": { "text": "Official Grill Rescue support" } }
      ]
    }
  ]
}
{% endschema %}
